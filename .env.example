# ==========================================
# LegalMetriScan Environment Configuration
# ==========================================

# FRONTEND CONFIGURATION (Render Static Site / Vite)
# In production, set this to your deployed Render backend service URL.
# In local development, leave blank or unset to use the local Vite proxy.
# Example:
# VITE_BACKEND_URL=https://legalmetriscan-backend.onrender.com
# VITE_SOCKET_URL=https://legalmetriscan-backend.onrender.com

# BACKEND CONFIGURATION (Render Web Service)
# PORT is automatically injected by Render (defaults to 4000 locally).
# PORT=4000
# JWT_SECRET=your_secure_random_jwt_secret_key_here
# PUBLIC_FRONTEND_URL=https://legalmetriscan.onrender.com
